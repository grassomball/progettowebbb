<file path="app/registrati/actions.ts">
"use server";

import db from "@/lib/db";
import bcrypt from "bcryptjs";
import { redirect } from "next/navigation";//funzione di Next.js per reindirizzare l'utente a un'altra pagina dopo che l'azione è completata.

export async function registraUtente(formData: FormData) {
    const username = formData.get("username") as string;
    const password = formData.get("password") as string;


    if (!username || !password){
        throw new Error("Username e password sono obbligatori");
    
    }

    if (password.length < 6){
        throw new Error("Password deve essere lunga almeno 6 caratteri");
    }

    const utenteEsistente = db 
    .prepare("SELECT * FROM Utente WHERE  username = ?")
    .get(username);

    if (utenteEsistente){
        throw new Error("Username già in uso");
    }

    const passwordHash = await bcrypt.hash(password, 10);

    db.prepare("INSERT INTO Utente (username, password_hash) VALUES (?, ?)")
    .run(username, passwordHash);

    redirect("/login");
}
</file>


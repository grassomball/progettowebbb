import { redirect } from "next/navigation";
import { getUserIdDaSessione } from "@/lib/session";

export default async function AreaPrivataPage() {
  const userId = await getUserIdDaSessione();

  if (!userId) {
    redirect("/login");
  }

  return (
    <div className="max-w-2xl mx-auto px-6 py-16">
      <h1 className="text-3xl font-bold text-black dark:text-white mb-6">
        Area privata
      </h1>

      <p className="text-lg text-zinc-700 dark:text-zinc-300 mb-4">
        Questa sezione e visibile solo agli utenti autenticati. L'accesso e
        protetto tramite un cookie di sessione: al momento del login viene
        creato un cookie httpOnly contenente l'identificativo dell'utente,
        che il server verifica ad ogni richiesta per confermare
        l'autenticazione.
      </p>

      <p className="text-lg text-zinc-700 dark:text-zinc-300">
        Il cookie non e accessibile da JavaScript lato client, riducendo il
        rischio di furto della sessione tramite script malevoli iniettati
        nella pagina.
      </p>
    </div>
  );
}

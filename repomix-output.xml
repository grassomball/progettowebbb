<file path="lib/session.ts">
import { cookies } from "next/headers";

const SESSION_COOKIE_NAME = "session_user_id";

export async function creaSessione(userId: number) {
  const cookieStore = await cookies();
  cookieStore.set(SESSION_COOKIE_NAME, String(userId), {
    httpOnly: true,
    secure: process.env.NODE_ENV === "production",
    sameSite: "lax",
    path: "/",
    maxAge: 60 * 60 * 24 * 7,
  });
}

export async function getUserIdDaSessione(): Promise<number | null> {
  const cookieStore = await cookies();
  const cookie = cookieStore.get(SESSION_COOKIE_NAME);

  if (!cookie) {
    return null;
  }

  const userId = parseInt(cookie.value, 10);
  return isNaN(userId) ? null : userId;
}

export async function distruggiSessione() {
  const cookieStore = await cookies();
  cookieStore.delete(SESSION_COOKIE_NAME);
}

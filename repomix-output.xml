<file path="app/login/actions.ts">
"use server";

import db from "@/lib/db";
import bcrypt from "bcryptjs";
import { creaSessione } from "@/lib/session";
import { redirect } from "next/navigation";

interface Utente {
  id: number;
  username: string;
  password_hash: string;
}

export async function loginUtente(formData: FormData) {
  const username = formData.get("username") as string;
  const password = formData.get("password") as string;

  if (!username || !password) {
    throw new Error("Username e password sono obbligatori");
  }

  const utente = db
    .prepare("SELECT id, username, password_hash FROM Utente WHERE username = ?")
    .get(username) as Utente | undefined;

  if (!utente) {
    throw new Error("Credenziali non valide");
  }

  const passwordCorretta = await bcrypt.compare(password, utente.password_hash);

  if (!passwordCorretta) {
    throw new Error("Credenziali non valide");
  }

  await creaSessione(utente.id);

  redirect("/area-privata");
}
</file>

